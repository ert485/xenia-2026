# Environment values never get committed: account IDs, zone IDs, keys.
*.tfvars
!*.example.tfvars
*.local.env
.env
.terraform/
.terraform-validate/
.terraform-plugin-cache/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# local-only files created by the kit scripts
*.local.hcl
.venv/
site/build/
site/dist/
*.pem
node_modules/
docs/proofs/*.raw
# the verifier's own output and the broker's request/result files never get committed
.agent/
.agent-requests/
